{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EC2Tagging",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DescribeInstances",
        "ec2:DescribeVolumes",
        "ec2:DescribeSnapshots",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeRouteTables",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeNatGateways",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeKeyPairs",
        "ec2:DescribeAddresses"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3Tagging",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketTagging",
        "s3:PutBucketTagging",
        "s3:ListAllMyBuckets"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RDSTagging",
      "Effect": "Allow",
      "Action": [
        "rds:AddTagsToResource",
        "rds:ListTagsForResource",
        "rds:DescribeDBInstances",
        "rds:DescribeDBClusters"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LambdaTagging",
      "Effect": "Allow",
      "Action": [
        "lambda:TagResource",
        "lambda:ListTags",
        "lambda:ListFunctions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DynamoDBTagging",
      "Effect": "Allow",
      "Action": [
        "dynamodb:TagResource",
        "dynamodb:ListTagsOfResource",
        "dynamodb:ListTables",
        "dynamodb:DescribeTable"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ECSTagging",
      "Effect": "Allow",
      "Action": [
        "ecs:TagResource",
        "ecs:ListTagsForResource",
        "ecs:ListClusters",
        "ecs:ListServices",
        "ecs:DescribeClusters",
        "ecs:DescribeServices"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EKSTagging",
      "Effect": "Allow",
      "Action": [
        "eks:TagResource",
        "eks:ListTagsForResource",
        "eks:ListClusters",
        "eks:DescribeCluster"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SNSTagging",
      "Effect": "Allow",
      "Action": [
        "sns:TagResource",
        "sns:ListTagsForResource",
        "sns:ListTopics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SQSTagging",
      "Effect": "Allow",
      "Action": [
        "sqs:TagQueue",
        "sqs:ListQueueTags",
        "sqs:ListQueues"
      ],
      "Resource": "*"
    },
    {
      "Sid": "KMSTagging",
      "Effect": "Allow",
      "Action": [
        "kms:TagResource",
        "kms:ListResourceTags",
        "kms:ListKeys",
        "kms:DescribeKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:*"
    }
  ]
}
