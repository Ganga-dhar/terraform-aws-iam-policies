{
  "Version": "2012-10-17",
  "Statement": [

    {
      "Sid": "ListBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "${bucket_arn}"
      ]
    },

    {
      "Sid": "ReadWriteObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "${bucket_arn}/*"
      ]
    },

    {
      "Sid": "ExplicitDenyDelete",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": [
        "${bucket_arn}/*"
      ]
    }

  ]
}