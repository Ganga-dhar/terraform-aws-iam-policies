{
  "Version": "2012-10-17",
  "Statement": [

    {
      "Sid": "AllowDeveloper",

      "Effect": "Allow",

      "Principal": {

        "AWS": "${developer_user_arn}"
      },

      "Action": [

        "s3:ListBucket"

      ],

      "Resource": "${bucket_arn}"
    },

    {
      "Sid": "AllowDeveloperObjects",

      "Effect": "Allow",

      "Principal": {

        "AWS": "${developer_user_arn}"
      },

      "Action": [

        "s3:GetObject",
        "s3:PutObject"

      ],

      "Resource": "${bucket_arn}/*"
    }

  ]
}